{
  // Checks the published declarations (emitted by TS 7) the way a client compiler reads them.
  // Used by `test:types:ts59` to verify the supported floor, TypeScript 5.9 (see docs/design.md D9).
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": ["dist/**/*.d.ts"]
}
