{
  "name": "@frankmeza/affirm",
  "version": "0.0.2",
  "description": "Runtime checks that read like a spec: one object of named checks that returns a boolean and narrows TypeScript types.",
  "keywords": [
    "typescript",
    "type-guard",
    "narrowing",
    "validation",
    "runtime-checks",
    "assert",
    "eslint-plugin",
    "standard-schema"
  ],
  "author": "Frank Meza",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frankmeza/affirm.git"
  },
  "homepage": "https://github.com/frankmeza/affirm#readme",
  "bugs": {
    "url": "https://github.com/frankmeza/affirm/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "AGENTS.md",
    "docs/client-usage.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./eslint": {
      "types": "./dist/eslint/index.d.ts",
      "import": "./dist/eslint.js"
    }
  },
  "scripts": {
    "build": "npm run typecheck && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types:ts59": "npm run build && node node_modules/typescript-5.9/bin/tsc --noEmit -p tsconfig.json && node node_modules/typescript-5.9/bin/tsc -p tsconfig.dts.json",
    "test:eslint9": "vitest run --config vitest.eslint9.config.ts",
    "test:types:consumer": "tsc -p test/fixtures/consumer-nodenext && node node_modules/typescript-5.9/bin/tsc -p test/fixtures/consumer-nodenext",
    "prepare": "npm ci --prefix test/fixtures/ts-parser --no-audit --no-fund"
  },
  "peerDependencies": {
    "eslint": ">=9",
    "typescript": ">=5.9"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "eslint-9": "npm:eslint@^9.39.5",
    "typescript": "~7.0.2",
    "typescript-5.9": "npm:typescript@5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
